---
/**
 * "Want more?" (#more), directly under the hero prompts: what Remote MCP is,
 * three reasons to add it, and buttons straight to the ChatGPT plugin and the
 * Claude connector. Other AI apps and more computers go to the platform, which
 * shows setup instructions after sign-in. Copy: data/welcome.ts.
 */
import Icon from '../home/Icon.astro';
import ClientMark from '../home/ClientMark.astro';
import { welcomeMore as more, AGENTS, TRY_REMOTE_URL, WELCOME_EXPERIMENT } from '../../data/welcome';

const ev = (o: Record<string, unknown>) =>
  JSON.stringify({ ...o, button_location: 'welcome_want_more', experiment: WELCOME_EXPERIMENT });
---

<section class="hx-section hx-wmore" id="more">
  <div class="hx-container">
    <header class="hx-head" data-reveal>
      <span class="hx-eyebrow"><span class="hx-eyebrow__text">{more.eyebrow}</span></span>
      <h2 class="hx-h2">
        {more.heading}
        <span class="hx-grad hx-wmore__accent">{more.headingAccent}</span>
      </h2>
      <p class="hx-sub">{more.sub}</p>
    </header>

    <ul class="hx-wmore__values">
      {
        more.values.map((v, i) => (
          <li class="hx-card hx-wmore__value" data-reveal style={`--d:${i * 90}`}>
            <span class="hx-remote__icon">
              <Icon name={v.icon} />
            </span>
            <h3>{v.title}</h3>
            <p>{v.description}</p>
            {'agents' in v && (
              <ul class="hx-wmore__agents">
                {v.agents.map((id) => (
                  <li class="hx-agent">
                    <span class="hx-agent__logo">
                      <img src={AGENTS[id].logo} alt="" width="16" height="16" loading="lazy" decoding="async" />
                    </span>
                    {AGENTS[id].name}
                  </li>
                ))}
                <li class="hx-agent hx-agent--any">
                  <span class="hx-agent__logo"><Icon name="plug" /></span>
                  {more.anyClient}
                </li>
              </ul>
            )}
          </li>
        ))
      }
    </ul>

    <div class="hx-wmore__add" data-reveal style="--d:200">
      <div class="hx-wmore__buttons">
        {
          more.add.map((a) => (
            <a
              class="hx-btn hx-btn--primary hx-wmore__btn"
              href={a.href}
              target="_blank"
              rel="noopener noreferrer"
              data-ev="install_cta_clicked"
              data-ev-props={ev({ button_text: a.label, client: a.client, destination: a.href })}
            >
              <span class="hx-wmore__mark">
                <ClientMark client={a.client} />
              </span>
              {a.label}
              <Icon name="arrow-up-right" />
            </a>
          ))
        }
      </div>
      <div class="hx-wmore__other">
        <p class="hx-wmore__other-lead">{more.otherLead}</p>
        <ul class="hx-wmore__tiles">
          {
            more.otherAgents.map((id) => (
              <li class="hx-tile">
                <span class="hx-tile__logo">
                  <img src={AGENTS[id].logo} alt="" width="28" height="28" loading="lazy" decoding="async" />
                </span>
                <span class="hx-tile__name">{AGENTS[id].name}</span>
              </li>
            ))
          }
          <li class="hx-tile hx-tile--any">
            <span class="hx-tile__logo"><Icon name="plug" /></span>
            <span class="hx-tile__name">{more.anyClient}</span>
          </li>
        </ul>
        <a
          class="hx-link hx-wmore__signin"
          href={TRY_REMOTE_URL}
          target="_blank"
          rel="noopener noreferrer"
          data-ev="remote_mcp_cta_clicked"
          data-ev-props={ev({ button_text: more.other, destination: TRY_REMOTE_URL })}
        >
          {more.other} &rarr;
        </a>
      </div>
    </div>
  </div>
</section>
