---
/**
 * "What Remote adds" (#compare): the local MCP the visitor just installed,
 * next to Remote MCP, one row per difference. On wide screens it reads as a
 * table with the row labels on the left; on narrow screens each column is a
 * card with its own labels.
 */
import Icon from '../home/Icon.astro';
import { compare, TRY_REMOTE_URL, WELCOME_EXPERIMENT } from '../../data/welcome';

const ev = JSON.stringify({
  button_text: compare.remote.tag,
  button_location: 'welcome_compare',
  destination: TRY_REMOTE_URL,
  experiment: WELCOME_EXPERIMENT,
});
---

<section class="hx-section hx-compare" id="compare">
  <div class="hx-rule" aria-hidden="true"></div>
  <div class="hx-container">
    <header class="hx-head" data-reveal>
      <span class="hx-eyebrow"><span class="hx-eyebrow__text">Local vs Remote</span></span>
      <h2 class="hx-h2">{compare.heading}</h2>
      <p class="hx-sub">{compare.sub}</p>
    </header>

    <div class="hx-compare__table" role="table" aria-label="Local MCP compared with Remote MCP" data-reveal style="--d:80">
      <div class="hx-compare__labels" role="rowgroup" aria-hidden="true">
        <span class="hx-compare__corner"></span>
        {compare.rows.map((row) => <span class="hx-compare__label">{row.label}</span>)}
      </div>

      <div class="hx-card hx-compare__col hx-compare__col--local" role="rowgroup">
        <div class="hx-compare__top">
          <h3>{compare.local.name}</h3>
          <span class="hx-compare__tag hx-compare__tag--done">
            <Icon name="check" strokeWidth={2.6} />
            {compare.local.tag}
          </span>
        </div>
        {
          compare.rows.map((row) => (
            <p class="hx-compare__cell" role="row">
              <span class="hx-compare__cell-label" role="rowheader">{row.label}</span>
              <span role="cell">{row.local}</span>
            </p>
          ))
        }
      </div>

      <div class="hx-card hx-compare__col hx-compare__col--remote" role="rowgroup">
        <div class="hx-compare__top">
          <h3>{compare.remote.name}</h3>
          <a
            class="hx-compare__tag hx-compare__tag--try"
            href={TRY_REMOTE_URL}
            target="_blank"
            rel="noopener noreferrer"
            data-ev="remote_mcp_cta_clicked"
            data-ev-props={ev}
          >
            {compare.remote.tag}
            <Icon name="arrow-right" />
          </a>
        </div>
        {
          compare.rows.map((row) => (
            <p class="hx-compare__cell" role="row">
              <span class="hx-compare__cell-label" role="rowheader">{row.label}</span>
              <span role="cell">{row.remote}</span>
            </p>
          ))
        }
      </div>
    </div>
  </div>
</section>
