---
import { excerptText, type BlogPost } from '../../data/blog/posts';
interface Props { post: BlogPost; showCategories?: boolean; showAuthor?: boolean; words?: number }
const { post, showCategories = true, showAuthor = true, words = 20 } = Astro.props;
const href = `/blog/${post.slug}/`;
const dateStr = new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<article class="post-card">
  <a href={href} class="post-card-link">
    {post.featured_image && (
      <div class="post-card-image-wrapper">
        <img src={post.featured_image} alt={post.title} class="post-card-image" loading="lazy" />
      </div>
    )}
    <div class="post-card-content">
      <h3 class="post-card-title">{post.title}</h3>
      <div class="post-card-excerpt">{excerptText(post, words)}</div>
      <div class="post-card-meta">
        <span>{dateStr}</span>
        {showAuthor && <span>{post.author_name}</span>}
      </div>
    </div>
  </a>
  {showCategories && post.categories.length > 0 && (
    <div class="post-card-categories">
      {post.categories.map((slug, i) => (
        <a href={`/blog/category/${slug}/`} class="post-category-tag">{post.category_names[i] || slug}</a>
      ))}
    </div>
  )}
</article>
