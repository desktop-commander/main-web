---
/**
 * Cross-linking grid for /mcp/<client>/ landing pages.
 *
 * Shows all client pages except the current one (SEO: internal links between
 * siblings). Used on the /mcp/ hub ("Set it up for your AI client", all 4)
 * and on each client page ("Also works with", the other 3).
 *
 * Usage:
 *   <MoreClients current="chatgpt" heading="Also works with" />
 *   <MoreClients heading="Set it up for your AI client" />
 */
import { mcpClients } from '../data/mcp-clients';

interface Props {
  /** Slug of the current page so it can be excluded from the grid */
  current?: string;
  heading?: string;
}

const { current, heading = 'Use Desktop Commander with your AI client' } = Astro.props;

const others = mcpClients.filter((c) => c.slug !== current);
const gridCols =
  others.length >= 4
    ? 'sm:grid-cols-2 lg:grid-cols-4'
    : 'sm:grid-cols-2 lg:grid-cols-3';

/** Official OpenAI knot mark (chatgpt has no PNG asset) */
const OPENAI_PATH =
  'M9.205 8.658v-2.26c0-.19.072-.333.238-.428l4.543-2.616c.619-.357 1.356-.523 2.117-.523 2.854 0 4.662 2.212 4.662 4.566 0 .167 0 .357-.024.547l-4.71-2.759a.797.797 0 00-.856 0l-5.97 3.473zm10.609 8.8V12.06c0-.333-.143-.57-.429-.737l-5.97-3.473 1.95-1.118a.433.433 0 01.476 0l4.543 2.617c1.309.76 2.189 2.378 2.189 3.948 0 1.808-1.07 3.473-2.76 4.163zM7.802 12.703l-1.95-1.142c-.167-.095-.239-.238-.239-.428V5.899c0-2.545 1.95-4.472 4.591-4.472 1 0 1.927.333 2.712.928L8.23 5.067c-.285.166-.428.404-.428.737v6.898zM12 15.128l-2.795-1.57v-3.33L12 8.658l2.795 1.57v3.33L12 15.128zm1.796 7.23c-1 0-1.927-.332-2.712-.927l4.686-2.712c.285-.166.428-.404.428-.737v-6.898l1.974 1.142c.167.095.238.238.238.428v5.233c0 2.545-1.974 4.472-4.614 4.472zm-5.637-5.303l-4.544-2.617c-1.308-.761-2.188-2.378-2.188-3.948A4.482 4.482 0 014.21 6.327v5.423c0 .333.143.571.428.738l5.947 3.449-1.95 1.118a.432.432 0 01-.476 0zm-.262 3.9c-2.688 0-4.662-2.021-4.662-4.519 0-.19.024-.38.047-.57l4.686 2.71c.286.167.571.167.856 0l5.97-3.448v2.26c0 .19-.07.333-.237.428l-4.543 2.616c-.619.357-1.356.523-2.117.523zm5.899 2.83a5.947 5.947 0 005.827-4.756C22.287 18.339 24 15.84 24 13.296c0-1.665-.713-3.282-1.998-4.448.119-.5.19-.999.19-1.498 0-3.401-2.759-5.947-5.946-5.947-.642 0-1.26.095-1.88.31A5.962 5.962 0 0010.205 0a5.947 5.947 0 00-5.827 4.757C1.713 5.447 0 7.945 0 10.49c0 1.666.713 3.283 1.998 4.448-.119.5-.19 1-.19 1.499 0 3.401 2.759 5.946 5.946 5.946.642 0 1.26-.095 1.88-.309a5.96 5.96 0 004.162 1.713z';
---

<section class="relative py-16 md:py-20 bg-dc-surface/30 border-t border-dc-border/60 overflow-hidden">
  <!-- Atmosphere -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div
      class="absolute -top-32 left-1/2 -translate-x-1/2 w-[700px] h-[350px] rounded-full bg-primary/10 blur-[120px]"
    >
    </div>
  </div>

  <div class="container mx-auto max-w-6xl px-4 sm:px-6 relative">
    <h2 class="text-3xl sm:text-4xl font-bold text-foreground text-center mb-3">
      {heading}
    </h2>
    <p class="text-lg text-muted-foreground text-center mb-12">
      One Desktop Commander, every AI client you use.
    </p>

    <div class={`grid grid-cols-1 ${gridCols} gap-4 md:gap-5`}>
      {
        others.map((client) => (
          <a
            href={`/mcp/${client.slug}/`}
            class="dc-client-card group relative flex flex-col p-6 rounded-2xl bg-dc-card border border-dc-border overflow-hidden transition-all duration-300 hover:border-primary/50 hover:-translate-y-1.5 hover:shadow-elegant"
            data-crosslink-to={client.slug}
          >
            {/* Hover glow */}
            <span
              class="absolute -top-16 left-1/2 -translate-x-1/2 w-48 h-32 rounded-full bg-primary/20 blur-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-500"
              aria-hidden="true"
            />

            <span class="relative flex items-start justify-between mb-5">
              <span class="w-14 h-14 rounded-2xl bg-white border border-dc-border flex items-center justify-center shadow-sm transition-transform duration-300 group-hover:scale-110">
                {client.slug === 'chatgpt' ? (
                  <svg viewBox="0 0 24 24" class="w-8 h-8 text-black" fill="currentColor" fill-rule="evenodd" aria-hidden="true">
                    <path d={OPENAI_PATH} />
                  </svg>
                ) : client.logo ? (
                  <img
                    src={`/${client.logo}`}
                    alt=""
                    class="w-8 h-8 object-contain"
                    loading="lazy"
                  />
                ) : (
                  <span class="text-xl font-bold text-black">{client.name.charAt(0)}</span>
                )}
              </span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-5 h-5 text-primary opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300"
                aria-hidden="true"
              >
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="12 5 19 12 12 19" />
              </svg>
            </span>

            <span class="relative block text-xs uppercase tracking-widest text-muted-foreground mb-1">
              Desktop Commander for
            </span>
            <span class="relative block text-xl font-bold text-foreground mb-4 group-hover:text-primary transition-colors">
              {client.name}
            </span>

            <span class="relative mt-auto flex items-center gap-2">
              <span
                class={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-medium border ${
                  client.transport === 'remote'
                    ? 'bg-green-500/10 text-green-400 border-green-500/20'
                    : 'bg-primary/10 text-primary border-primary/20'
                }`}
              >
                <span
                  class={`w-1.5 h-1.5 rounded-full ${
                    client.transport === 'remote' ? 'bg-green-400' : 'bg-primary'
                  }`}
                />
                {client.transport === 'remote' ? 'Remote MCP' : 'Local MCP'}
              </span>
              <span class="text-xs text-muted-foreground">files & terminal</span>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<script define:vars={{ current }}>
  // Analytics: track cross-link clicks between client landing pages.
  document.querySelectorAll('[data-crosslink-to]').forEach((a) => {
    a.addEventListener('click', () => {
      if (window.posthog) {
        window.posthog.capture('mcp_client_crosslink_clicked', {
          from_client: current || 'mcp_hub',
          to_client: a.dataset.crosslinkTo,
        });
      }
    });
  });
</script>
