---
/** Closing section: the same two CTAs as the hero, and nothing else. */
import Icon from './Icon.astro';
import { finalCta, PLATFORM_URL } from '../../data/home';

const ev = (o: Record<string, unknown>) => JSON.stringify(o);
---

<section class="hx-section hx-final">
  <div class="hx-rule" aria-hidden="true"></div>

  <div class="hx-container hx-final__inner">
    <h2 class="hx-h2" data-reveal>{finalCta.heading}</h2>
    <p class="hx-sub" data-reveal style="--d:80">{finalCta.sub}</p>

    <div class="hx-hero__cta" data-reveal style="--d:160">
      <a
        class="hx-btn hx-btn--primary"
        href="#install"
        data-ev="install_cta_clicked"
        data-ev-props={ev({
          button_text: 'Install',
          button_location: 'home_final_cta',
          destination: '#install',
        })}
      >
        Install
        <Icon name="arrow-right" />
      </a>
      <a
        class="hx-btn hx-btn--ghost"
        href={PLATFORM_URL}
        target="_blank"
        rel="noopener noreferrer"
        data-ev="manage_devices_clicked"
        data-ev-props={ev({
          button_text: 'Manage devices',
          button_location: 'home_final_cta',
          destination: PLATFORM_URL,
        })}
      >
        Manage devices
      </a>
    </div>
  </div>
</section>
