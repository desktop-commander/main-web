---
/**
 * Dev only: a small switch in the corner to flip between the two hero
 * versions while comparing them (see HomePage.astro, pages/preview/[hero].astro).
 * It is rendered only by the dev server (see dev-server.ts) and its styles are
 * inline, so nothing of it reaches a build.
 */
interface Props {
  current: 'hub' | 'stage';
}
const { current } = Astro.props;
---

<nav class="hx-devswitch" aria-label="Preview: hero versions">
  <span>Hero</span>
  <a href="/preview/hero-a/" aria-current={current === 'stage' ? 'page' : undefined}>A: live demo</a>
  <a href="/" aria-current={current === 'hub' ? 'page' : undefined}>B: connections</a>
</nav>

<style is:inline>
  .hx-devswitch {
    position: fixed;
    left: 14px;
    bottom: 14px;
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 4px;
    border-radius: 12px;
    background: hsl(222 28% 8% / 0.92);
    box-shadow:
      inset 0 0 0 1px hsl(218 40% 85% / 0.2),
      0 12px 30px -10px rgba(0, 0, 0, 0.8);
    font: 500 12px/1 'Geist Variable', system-ui, sans-serif;
    color: hsl(218 16% 62%);
  }
  .hx-devswitch span {
    padding: 0 8px 0 9px;
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .hx-devswitch a {
    padding: 8px 11px;
    border-radius: 8px;
    color: hsl(216 24% 80%);
    text-decoration: none;
  }
  .hx-devswitch a:hover {
    background: rgba(255, 255, 255, 0.08);
  }
  .hx-devswitch a[aria-current='page'] {
    background: #2563eb;
    color: #fff;
  }
</style>
