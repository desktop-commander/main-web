---
/** Remote MCP plans (#pricing), mirroring what users see in Plan & billing. */
import Icon from './Icon.astro';
import { pricing } from '../../data/home';

/**
 * Another page can relabel the Free plan's button and tag the clicks with its
 * own location (e.g. /welcome/, which has no #install chooser).
 */
interface Props {
  location?: string;
  freeCta?: { label: string; href: string; external: boolean };
  /** Where Pro's button goes, e.g. the platform URL with tracking parameters. */
  proHref?: string;
  extraProps?: Record<string, unknown>;
}
const { location = 'home_pricing', freeCta, proHref, extraProps = {} } = Astro.props;
const plans = pricing.plans.map((plan) => {
  if (plan.highlighted) return proHref ? { ...plan, cta: { ...plan.cta, href: proHref } } : plan;
  return freeCta ? { ...plan, cta: freeCta } : plan;
});
---

<section class="hx-section hx-pricing" id="pricing">
  <div class="hx-rule" aria-hidden="true"></div>
  <div class="hx-container">
    <header class="hx-head" data-reveal>
      <span class="hx-eyebrow"><span class="hx-eyebrow__text">Plans</span></span>
      <h2 class="hx-h2">{pricing.heading}</h2>
      <p class="hx-sub">{pricing.sub}</p>
    </header>

    <div class="hx-plans">
      {
        plans.map((plan, i) => (
          <article
            class:list={['hx-card', 'hx-plan', { 'hx-plan--pro': plan.highlighted }]}
            data-reveal
            style={`--d:${i * 120}`}
          >
            <h3>{plan.name}</h3>
            <div class="hx-plan__cost">
              <p class="hx-plan__price">
                <span>{plan.price}</span>
                <small>{plan.period}</small>
              </p>
              {/* What is added to the price. A plan without a note keeps the empty row on wide
                  screens, so the two lists start level. */}
              {
                plan.priceNote ? (
                  <p class="hx-plan__note">{plan.priceNote}</p>
                ) : (
                  <p class="hx-plan__note hx-plan__note--none" aria-hidden="true">&nbsp;</p>
                )
              }
            </div>
            <ul class="hx-checks">
              {plan.features.map((feature) => (
                <li>
                  <Icon name="check" strokeWidth={2.6} />
                  {feature}
                </li>
              ))}
            </ul>
            <a
              class:list={['hx-btn', 'hx-btn--block', plan.highlighted ? 'hx-btn--primary' : 'hx-btn--ghost']}
              href={plan.cta.href}
              target={plan.cta.external ? '_blank' : undefined}
              rel={plan.cta.external ? 'noopener noreferrer' : undefined}
              data-ev="pricing_cta_clicked"
              data-ev-props={JSON.stringify({
                button_text: plan.cta.label,
                button_location: location,
                plan: plan.name.toLowerCase(),
                destination: plan.cta.href,
                ...extraProps,
              })}
            >
              {plan.cta.label}
              <Icon name="arrow-right" />
            </a>
          </article>
        ))
      }
    </div>

    <p class="hx-pricing__note" data-reveal>
      {pricing.note}{' '}
      <a class="hx-link" href={pricing.noteLink.href}>{pricing.noteLink.label}</a>
    </p>
  </div>
</section>
