---
import BlogLayout from '../../layouts/BlogLayout.astro';
import { site } from '../../data/blog/posts';
const canonical = 'https://desktopcommander.app/blog/search/';
---
<BlogLayout
  title={`Search | ${site.name}`}
  description="Search the Desktop Commander blog for guides on MCP servers, AI automation, local development, and more."
  canonical={canonical}
  ogTitle="Search"
  ogType="website"
  ogUrl={canonical}
  robots="noindex, follow"
  bodyClass="search-page"
>
  <main class="site-content">
    <header class="single-post-header">
      <h1 class="single-post-title">Search the blog</h1>
    </header>
    <div class="blog-search-wrapper" style="max-width: 760px; margin: 0 auto; padding: 0 1.5rem 4rem;">
      <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
      <div id="search"></div>
      <script is:inline src="/pagefind/pagefind-ui.js"></script>
      <script is:inline>
        window.addEventListener('DOMContentLoaded', () => {
          if (window.PagefindUI) {
            new window.PagefindUI({ element: '#search', showSubResults: true, showImages: false });
          }
        });
      </script>
    </div>
  </main>
</BlogLayout>
