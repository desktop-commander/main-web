---
import BlogLayout from '../../layouts/BlogLayout.astro';
import HomeListing from '../../components/blog/HomeListing.astro';
import { posts, site, OG_FALLBACK } from '../../data/blog/posts';
import { siteGraph } from '../../data/blog/schema';

const PER = 9;
const featured = posts[0];
const remaining = posts.slice(1);
const totalPages = Math.max(1, Math.ceil(remaining.length / PER));
const gridPosts = remaining.slice(0, PER);

const description = 'Discover guides on MCP servers, AI automations, and local development. Expert tutorials from the Desktop Commander team to supercharge your AI workflow.';
---
<BlogLayout
  title={`${site.name} | ${site.description}`}
  description={description}
  canonical="https://desktopcommander.app/blog/"
  ogTitle={site.name}
  ogType="website"
  ogUrl="https://desktopcommander.app/blog/"
  ogImage={OG_FALLBACK}
  jsonLd={[siteGraph()]}
  bodyClass="blog home"
>
  <HomeListing featured={featured} gridPosts={gridPosts} current={1} totalPages={totalPages} />
</BlogLayout>
