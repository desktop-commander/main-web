---
import BlogLayout from '../../layouts/BlogLayout.astro';
import { pageBySlug, site, OG_FALLBACK } from '../../data/blog/posts';
import { pageGraph } from '../../data/blog/schema';

const page = pageBySlug('about');
const canonical = 'https://desktopcommander.app/blog/about/';
const title = `About Desktop Commander | ${site.name}`;
const description = 'Desktop Commander combines local filesystem access with full terminal control, letting you handle complex technical tasks through natural language.';
const jsonLd = page ? [pageGraph('About Desktop Commander', canonical, page.date, page.modified)] : [];
---
<BlogLayout title={title} description={description} canonical={canonical} ogTitle="About Desktop Commander" ogType="website" ogUrl={canonical} ogImage={OG_FALLBACK} jsonLd={jsonLd} bodyClass="page page-about">
  <main class="site-content">
    <article class="about-page">
      <section class="about-hero">
        <div class="about-hero-content">
          <h1 class="about-hero-title">About Desktop Commander</h1>
          <p class="about-hero-description">
            Desktop Commander combines local filesystem access with full terminal control, enabling you to handle complex technical tasks through natural language. Whether you're a seasoned developer or just getting started, Desktop Commander empowers you to work faster and smarter.
          </p>
        </div>
      </section>

      <section class="about-stats-section">
        <div class="about-container">
          <div class="about-stats-grid">
            <a href="https://www.npmjs.com/package/@wonderwhy-er/desktop-commander" target="_blank" rel="noopener noreferrer" class="about-stat-card about-stat-link">
              <div class="about-stat-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" x2="12" y1="15" y2="3"></line></svg>
              </div>
              <div class="about-stat-number">26k+</div>
              <div class="about-stat-label">Weekly Downloads</div>
            </a>
            <a href="https://github.com/wonderwhy-er/DesktopCommanderMCP" target="_blank" rel="noopener noreferrer" class="about-stat-card about-stat-link">
              <div class="about-stat-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"></path></svg>
              </div>
              <div class="about-stat-number">4.3k+</div>
              <div class="about-stat-label">GitHub Stars</div>
            </a>
            <div class="about-stat-card">
              <div class="about-stat-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
              </div>
              <div class="about-stat-number">9.5/10</div>
              <div class="about-stat-label">User Rating</div>
            </div>
          </div>
        </div>
      </section>

      <section class="about-capabilities-section">
        <div class="about-container">
          <h2 class="about-section-title">Key Capabilities</h2>
          <p class="about-section-subtitle">Desktop Commander bridges technical skill gaps by providing full command-line superpowers through an interface that understands your intent and handles complexity automatically.</p>
          <div class="about-capabilities-grid-2x2">
            <div class="about-capability-card">
              <div class="about-capability-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path></svg></div>
              <div><h3 class="about-capability-title">File System Operations</h3><p class="about-capability-desc">Read, write, search, and manage files with natural language commands</p></div>
            </div>
            <div class="about-capability-card">
              <div class="about-capability-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" x2="20" y1="19" y2="19"></line></svg></div>
              <div><h3 class="about-capability-title">Terminal Control</h3><p class="about-capability-desc">Execute commands, manage processes, and automate workflows</p></div>
            </div>
            <div class="about-capability-card">
              <div class="about-capability-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 16 4-4-4-4"></path><path d="m6 8-4 4 4 4"></path><path d="m14.5 4-5 16"></path></svg></div>
              <div><h3 class="about-capability-title">Code Analysis</h3><p class="about-capability-desc">Understand codebases, debug issues, and implement fixes</p></div>
            </div>
            <div class="about-capability-card">
              <div class="about-capability-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"></path></svg></div>
              <div><h3 class="about-capability-title">Workflow Automation</h3><p class="about-capability-desc">Automate repetitive tasks and build custom development pipelines</p></div>
            </div>
          </div>
        </div>
      </section>

      <section class="about-video-section">
        <div class="about-container">
          <h2 class="about-video-title">Check our founder talking about DC:</h2>
          <div class="about-video-container">
            <div class="about-video-wrapper">
              <iframe src="https://www.youtube.com/embed/xNlSt-4vTTo" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
            </div>
          </div>
        </div>
      </section>

      <section class="about-cta-section">
        <div class="about-container">
          <div class="about-cta-card">
            <h2 class="about-cta-title">Join Our Community</h2>
            <p class="about-cta-text">Connect with thousands of developers building with Desktop Commander</p>
            <div class="about-cta-buttons">
              <a href="https://discord.gg/pV5kqKZuK" target="_blank" rel="noopener noreferrer" class="about-btn about-btn-primary"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path></svg>Join Discord</a>
              <a href="https://github.com/wonderwhy-er/DesktopCommanderMCP" target="_blank" rel="noopener noreferrer" class="about-btn about-btn-secondary"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>View on GitHub</a>
            </div>
          </div>
        </div>
      </section>
    </article>
  </main>
</BlogLayout>
