---
import BlogLayout from '../../layouts/BlogLayout.astro';
import { pageBySlug, site, OG_FALLBACK } from '../../data/blog/posts';
import { pageGraph } from '../../data/blog/schema';
import contactBody from '../../blog-content/page-contact.html?raw';

const page = pageBySlug('contact');
const pageTitle = page?.title || 'Contact';
const canonical = 'https://desktopcommander.app/blog/contact/';
const title = `${pageTitle} | ${site.name}`;
const description = 'Get in touch with the Desktop Commander team — join our Discord community, open a GitHub issue, or follow us on X for updates.';
const jsonLd = page ? [pageGraph(pageTitle, canonical, page.date, page.modified)] : [];
---
<BlogLayout title={title} description={description} canonical={canonical} ogTitle={pageTitle} ogType="website" ogUrl={canonical} ogImage={OG_FALLBACK} jsonLd={jsonLd} bodyClass="page page-contact">
  <main class="site-content">
    <article class="contact-page">
      <section class="contact-hero">
        <div class="contact-hero-content">
          <h1 class="contact-hero-title">{pageTitle}</h1>
          <p class="contact-hero-subtitle">We'd love to hear from you</p>
        </div>
      </section>

      <section class="contact-section">
        <div class="contact-container">
          <div class="contact-grid">
            <div class="contact-info-block">
              <h2 class="contact-section-title">Get in Touch</h2>
              <div class="contact-content" set:html={contactBody} />

              <div class="contact-methods">
                <a href="https://discord.gg/pV5kqKZuK" target="_blank" rel="noopener noreferrer" class="contact-method-card">
                  <div class="contact-method-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path></svg></div>
                  <div class="contact-method-content"><h3 class="contact-method-title">Join Discord</h3><p class="contact-method-description">Chat with our community and get quick support</p></div>
                  <div class="contact-method-arrow"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></div>
                </a>
                <a href="https://github.com/wonderwhy-er/DesktopCommanderMCP/issues" target="_blank" rel="noopener noreferrer" class="contact-method-card">
                  <div class="contact-method-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg></div>
                  <div class="contact-method-content"><h3 class="contact-method-title">GitHub Issues</h3><p class="contact-method-description">Report bugs or request features</p></div>
                  <div class="contact-method-arrow"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></div>
                </a>
                <a href="https://x.com/desktopcommandr" target="_blank" rel="noopener noreferrer" class="contact-method-card">
                  <div class="contact-method-icon"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path></svg></div>
                  <div class="contact-method-content"><h3 class="contact-method-title">Follow on X</h3><p class="contact-method-description">Get the latest updates and news</p></div>
                  <div class="contact-method-arrow"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></div>
                </a>
              </div>
            </div>

            <div class="contact-faq-block">
              <div class="contact-faq-card">
                <h3 class="contact-faq-title">Quick Help</h3>
                <div class="contact-faq-list">
                  <div class="contact-faq-item">
                    <div class="contact-faq-icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path><polyline points="14 2 14 8 20 8"></polyline></svg></div>
                    <div><h4 class="contact-faq-question">Documentation</h4><p class="contact-faq-answer">Check our comprehensive guides and tutorials</p><a href="https://github.com/wonderwhy-er/DesktopCommanderMCP#readme" target="_blank" rel="noopener noreferrer" class="contact-faq-link">View Docs →</a></div>
                  </div>
                  <div class="contact-faq-item">
                    <div class="contact-faq-icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"></path><path d="M12 17h.01"></path></svg></div>
                    <div><h4 class="contact-faq-question">Common Issues</h4><p class="contact-faq-answer">Find solutions to frequently asked questions</p><a href="https://github.com/wonderwhy-er/DesktopCommanderMCP/issues" target="_blank" rel="noopener noreferrer" class="contact-faq-link">Browse Issues →</a></div>
                  </div>
                  <div class="contact-faq-item">
                    <div class="contact-faq-icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 18a5 5 0 0 0-10 0"></path><line x1="12" x2="12" y1="2" y2="9"></line><line x1="4.22" x2="5.64" y1="4.22" y2="5.64"></line><line x1="1" x2="3" y1="10" y2="10"></line><line x1="21" x2="23" y1="10" y2="10"></line><line x1="18.36" x2="19.78" y1="5.64" y2="4.22"></line><line x1="23" x2="21" y1="16" y2="16"></line><line x1="19.78" x2="18.36" y1="18.36" y2="19.78"></line><line x1="1" x2="3" y1="16" y2="16"></line></svg></div>
                    <div><h4 class="contact-faq-question">Feature Requests</h4><p class="contact-faq-answer">Suggest new features or improvements</p><a href="https://github.com/wonderwhy-er/DesktopCommanderMCP/issues/new" target="_blank" rel="noopener noreferrer" class="contact-faq-link">Submit Idea →</a></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </article>
  </main>
</BlogLayout>
