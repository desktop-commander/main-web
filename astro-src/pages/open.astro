---
import Layout from '../layouts/Layout.astro';
import PostHogInit from '../../src/components/PostHogInit';
import Navigation from '../components/Navigation.astro';
import Footer from '../../src/components/Footer';
import DownloadButtons from '../../src/components/shared/DownloadButtons';

// Deep-link page for launching the Desktop Commander app.
// HubSpot CTAs and other tracked entry points target /open so clicks
// can be counted, then the page fires the `desktopcommander://` custom
// protocol to launch the installed app.
//
// If the app is installed, the protocol handler takes over and the
// browser tab is left on this page in the background — so the content
// here only matters when the app didn't launch (not installed yet, or
// protocol blocked). For that fallback we show a friendly install
// prompt with native download buttons instead of redirecting to a
// non-existent /download page (which used to 404).
//
// Excluded from search indexing via robots.txt and the noindex meta
// tag set below.
---

<Layout
  title="Opening Desktop Commander…"
  description="Launching the Desktop Commander app. Don't have it yet? Install for macOS or Windows."
  robots="noindex, nofollow"
  googlebot="noindex, nofollow"
>
  <PostHogInit client:load />

  <div class="min-h-screen bg-background flex flex-col">
    <Navigation />

    <main class="flex-1 flex items-center justify-center px-4 sm:px-6 py-16 md:py-24">
      <div class="max-w-2xl w-full text-center">

        <!-- State 1: Launching -->
        <div id="launching-state" class="flex flex-col items-center">
          <div class="spinner mb-6"></div>
          <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold text-foreground mb-3">
            Opening Desktop Commander…
          </h1>
          <p class="text-base sm:text-lg text-muted-foreground max-w-md">
            If the app is installed, it should launch in a moment.
          </p>
        </div>

        <!-- State 2: Fallback (revealed after delay) -->
        <div id="fallback-state" class="hidden flex-col items-center">
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-foreground mb-4 leading-tight">
            App didn't open?
          </h1>
          <p class="text-base sm:text-lg text-muted-foreground mb-8 max-w-md mx-auto leading-relaxed">
            You probably don't have Desktop Commander installed yet.
            Grab it below — it takes under a minute.
          </p>

          <div class="mb-8">
            <DownloadButtons client:load location="open_fallback" variant="hero" />
          </div>

          <p class="text-sm text-muted-foreground">
            Already installed?
            <button
              id="retry-launch"
              type="button"
              class="text-blue-400 hover:text-blue-300 font-medium underline-offset-4 hover:underline"
            >
              Try opening it again
            </button>
          </p>
        </div>

      </div>
    </main>

    <Footer client:visible />
  </div>
</Layout>

<style>
  .spinner {
    width: 40px;
    height: 40px;
    border: 3px solid rgba(255, 255, 255, 0.08);
    border-top-color: #3b82f6;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  .hidden {
    display: none !important;
  }
</style>

<script is:inline>
  (function () {
    var launchingEl = document.getElementById('launching-state');
    var fallbackEl = document.getElementById('fallback-state');
    var retryBtn = document.getElementById('retry-launch');

    function launch() {
      window.location.href = 'desktopcommander://';
    }

    // Fire the protocol handler immediately on load.
    launch();

    // After ~2.5s, reveal the fallback (install / retry) UI.
    // If the app launched, the user is already in it and never sees this.
    // If it didn't, they get a clean install prompt instead of a 404.
    setTimeout(function () {
      if (launchingEl) launchingEl.classList.add('hidden');
      if (fallbackEl) {
        fallbackEl.classList.remove('hidden');
        fallbackEl.style.display = 'flex';
      }
    }, 2500);

    // Manual retry button on the fallback view.
    if (retryBtn) {
      retryBtn.addEventListener('click', function () {
        launch();
      });
    }
  })();
</script>
