---
/**
 * Homepage — MCP-first.
 *
 * Remote MCP is the product: Install is the only primary CTA, Manage devices
 * is the constant secondary, and the desktop app is off the main path.
 *
 * Structure: the sections are plain Astro components in
 * ../components/home/ (server-rendered HTML, no React island each), styled by
 * ../components/home/home.css and brought to life by the small scripts in
 * ../components/home/scripts/. Copy lives in ../data/home.ts.
 *
 * Navigation and Footer are the shared site components, unchanged.
 *
 * The previous homepage (React sections under src/components/home-mcp/) is
 * still in the repo and in git history if any of it needs to come back.
 */
import Layout from '../layouts/Layout.astro';
import { organizationSchema } from '../data/schema';
import Navigation from '../components/Navigation.astro';
import PostHogInit from '../../src/components/PostHogInit';
import Footer from '../../src/components/Footer';
import HomeHero from '../components/home/HomeHero.astro';
import HomeInstall from '../components/home/HomeInstall.astro';
import HomeRemote from '../components/home/HomeRemote.astro';
import HomeUseCases from '../components/home/HomeUseCases.astro';
import HomeHowItWorks from '../components/home/HomeHowItWorks.astro';
import HomePrompts from '../components/home/HomePrompts.astro';
import HomeClients from '../components/home/HomeClients.astro';
import HomeCommunity from '../components/home/HomeCommunity.astro';
import HomePricing from '../components/home/HomePricing.astro';
import HomeFaq from '../components/home/HomeFaq.astro';
import HomeFinalCta from '../components/home/HomeFinalCta.astro';
import '../components/home/home.css';
import '../components/home/home-sections.css';
---

<Layout
  title="Desktop Commander - Use your computer from chat"
  description="Desktop Commander gives ChatGPT and Claude access to your computer, so they read your files, run commands, and see the results themselves. Your own machine, not a cloud sandbox."
  jsonLd={organizationSchema}
>
  <!-- Fonts for the first screen. rel=preload is valid in <body>. -->
  <link rel="preload" href="/fonts/geist-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />

  <!--
    Marks the page as scripted before first paint, so sections below the hero
    can start hidden and reveal on scroll without a flash. If the main script
    has not started after 3 seconds (blocked, failed), everything is simply
    shown. The hero itself does not depend on this: its entrance is pure CSS.
  -->
  <script is:inline>
    document.documentElement.classList.add('hx-js');
    window.__hxFallback = setTimeout(function () {
      document.documentElement.classList.add('hx-noanim');
    }, 3000);
  </script>

  <PostHogInit client:idle />

  <div class="hx min-h-screen">
    <Navigation />
    <main>
      <HomeHero />
      <HomeInstall />
      <HomeRemote />
      <HomeUseCases />
      <HomeHowItWorks />
      <HomePrompts />
      <HomeClients />
      <HomeCommunity />
      <HomePricing />
      <HomeFaq />
      <HomeFinalCta />
    </main>
    <Footer client:visible />
  </div>
</Layout>

<script>
  import '../components/home/scripts/main.ts';
</script>
