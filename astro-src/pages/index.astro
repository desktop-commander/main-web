---
/**
 * Homepage — MCP-first.
 *
 * Remote MCP is the product: Install is the only primary CTA, Manage devices
 * is the constant secondary, and the desktop app is off the main path.
 *
 * The previous app-first homepage lives in git history (see the commit that
 * introduced this file) if any of it needs to come back.
 */
import Layout from '../layouts/Layout.astro';
import { organizationSchema } from '../data/schema';
import Navigation from '../components/Navigation.astro';
import MoreClients from '../components/MoreClients.astro';
import PostHogInit from '../../src/components/PostHogInit';
import HeroMcp from '../../src/components/home-mcp/HeroMcp';
import InstallChooser from '../../src/components/home-mcp/InstallChooser';
import MCPRemote from '../../src/components/mcp/MCPRemote';
import McpUseCases from '../../src/components/home-mcp/McpUseCases';
import HowItWorks from '../../src/components/home-mcp/HowItWorks';
import PromptLibrary from '../../src/components/PromptLibrary';
import McpPricing from '../../src/components/home-mcp/McpPricing';
import TrustedBy from '../../src/components/TrustedBy';
import MCPFAQ from '../../src/components/mcp/MCPFAQ';
import FinalInstall from '../../src/components/home-mcp/FinalInstall';
import Footer from '../../src/components/Footer';
---

<Layout
  title="Desktop Commander - Use your computer from chat"
  description="Desktop Commander gives ChatGPT and Claude access to your computer, so they read your files, run commands, and see the results themselves. Your own machine, not a cloud sandbox."
  jsonLd={organizationSchema}
>
  <PostHogInit client:idle />

  <div class="min-h-screen bg-background">
    <Navigation />
    <main>
      <HeroMcp client:load />
      <InstallChooser client:visible />
      <MCPRemote client:visible />
      <McpUseCases client:visible />
      <HowItWorks client:visible />
      <PromptLibrary client:visible />
      <MoreClients heading="Works with your AI client" />
      <TrustedBy client:visible />
      <McpPricing client:visible />
      <MCPFAQ client:visible />
      <FinalInstall client:visible />
    </main>
    <Footer client:visible />
  </div>
</Layout>

<style is:global>
  @import '../../src/index.css';
</style>
