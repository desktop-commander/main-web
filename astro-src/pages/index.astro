/**
 * Homepage — MCP-first.
 *
 * The page itself is astro-src/components/home/HomePage.astro. `hero` picks
 * the first screen: "hub" (the connection diagram) or "stage" (the live demo
 * under a centered headline). Change the one word below to switch.
 *
 * While developing, both versions can be compared side by side:
 * /preview/hero-a/ and /preview/hero-b/ (see pages/preview/[hero].astro).
 *
 * The previous homepage (React sections under src/components/home-mcp/) is
 * still in the repo and in git history if any of it needs to come back.
 */
import HomePage from '../components/home/HomePage.astro';
---

<HomePage hero="hub" />
