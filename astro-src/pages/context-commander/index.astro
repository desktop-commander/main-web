---
import Layout from '../../layouts/Layout.astro';
import '../../components/home/home.css';

// Set to the verified app-directory URL once Context Commander is published.
// No fallback to the Desktop Commander app or an unverified MCP endpoint.
const configuredUrl = import.meta.env.PUBLIC_CONTEXT_COMMANDER_APP_URL;
let connectUrl: string | undefined;
if (configuredUrl) {
  try {
    const url = new URL(configuredUrl);
    if (url.protocol === 'https:' && url.hostname === 'chatgpt.com') {
      connectUrl = url.href;
    }
  } catch {
    // A bad configuration keeps the pre-launch state.
  }
}

const steps = [
  {
    number: '01',
    title: 'Start a project',
    text: 'Ask your AI assistant to keep track of a project you are working on. Save its goal and the tasks ahead.',
    prompt: 'Track my website redesign project.',
  },
  {
    number: '02',
    title: 'Save your progress',
    text: 'Record what is finished, what you decided, what is blocked, and what should happen next.',
    prompt: 'Save where we stopped today.',
  },
  {
    number: '03',
    title: 'Pick up in a new chat',
    text: 'Ask to continue a saved project. Retrieve its context and get back to the work, without another long explanation.',
    prompt: 'Continue my website redesign.',
  },
];
---

<Layout
  title="Context Commander — Pick up where you left off"
  description="Save ongoing projects, decisions, tasks and next steps, and resume your work across AI conversations."
  robots="noindex, nofollow, noai, noimageai"
  googlebot="noindex, nofollow, noai"
  advertisingMeasurement={false}
>
  <div class="hx cc-page" data-pagefind-ignore="all">
    <header class="cc-header">
      <div class="hx-container cc-header-inner">
        <a href="#top" class="cc-brand" aria-label="Context Commander, page top">
          <span class="cc-mark" aria-hidden="true">
            <svg width="25" height="25" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M5 6h14M5 12h10M5 18h7" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              <path d="m17 15 3 3-3 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <span>Context Commander</span>
        </a>
        <span class="cc-byline">By Desktop Commander</span>
      </div>
    </header>

    <main id="top">
      <section class="cc-hero">
        <div class="hx-container cc-hero-grid">
          <div class="cc-copy">
            <p class="cc-kicker"><span></span> One project. Any compatible AI chat.</p>
            <h1>Pick up where<br class="cc-desktop-break"/> <span>you left off.</span></h1>
            <p class="cc-lead">Your AI chat ends. Your project doesn’t. Save the decisions, progress and next steps that matter, then pick up in a new conversation — even in another compatible AI app.</p>
            <div class="cc-actions">
              {connectUrl ? (
                <a class="cc-button" href={connectUrl}>Connect to ChatGPT <span aria-hidden="true">↗</span></a>
              ) : (
                <span class="cc-button cc-button-pending" aria-disabled="true">Coming soon</span>
              )}
              <a href="#how-it-works" class="cc-text-link">See how it works <span aria-hidden="true">↓</span></a>
            </div>
            <p class="cc-caption">Standalone MCP · No Desktop Commander installation or connected computer required.</p>
          </div>

          <div class="cc-visual" data-cc-demo aria-label="Interactive illustration of cross-chat project memory">
            <div class="cc-demo-top"><span class="cc-demo-live"><i></i> Interactive demo</span><button type="button" data-cc-pause aria-pressed="false">Pause</button></div>
            <div class="cc-scenario-tabs" aria-label="Choose an example">
              <button type="button" data-cc-scenario="0" aria-pressed="true">Development</button>
              <button type="button" data-cc-scenario="1" aria-pressed="false">Research</button>
              <button type="button" data-cc-scenario="2" aria-pressed="false">Business</button>
            </div>
            <div class="cc-chat" data-cc-source>
              <div class="cc-chat-header"><img src="/agents/chatgpt.svg" alt="" width="20" height="20" /> ChatGPT <span class="cc-muted">Yesterday</span></div>
              <div class="cc-bubble cc-user" data-cc-prompt>Save where we stopped on the website redesign.</div>
            </div>
            <div class="cc-wire" data-cc-wire="save" aria-hidden="true"><i></i><span data-cc-action>save_checkpoint</span></div>
            <div class="cc-memory" data-cc-memory>
              <div class="cc-memory-head"><span class="cc-mark cc-memory-mark" aria-hidden="true">▤</span><div><strong>Context Commander</strong><small>Persistent project memory</small></div><span class="cc-saved" data-cc-status>✓ Saved</span></div>
              <div class="cc-project">
                <span class="cc-project-label">PROJECT CHECKPOINT</span>
                <h2 data-cc-project>Website redesign</h2>
                <div class="cc-line"><span class="cc-status">✓</span><span data-cc-done>Homepage wireframes finished</span></div>
                <div class="cc-line"><span class="cc-status">✓</span><span data-cc-decision>Decision: simplify navigation</span></div>
                <div class="cc-line"><span class="cc-next">→</span><span data-cc-next>Next: build the pricing page</span></div>
              </div>
            </div>
            <div class="cc-wire" data-cc-wire="resume" aria-hidden="true"><i></i><span>resume_project</span></div>
            <div class="cc-chat cc-chat-resume" data-cc-target>
              <div class="cc-chat-header"><img data-cc-client-icon src="/agents/claude.svg" alt="" width="20" height="20" /><span data-cc-client>Claude</span><span class="cc-muted">Today · new chat</span></div>
              <div class="cc-bubble cc-user" data-cc-resume>Let's continue the website redesign.</div>
              <div class="cc-bubble cc-assistant" data-cc-answer>You're ready to build the pricing page. The wireframes are finished and the navigation decision is saved.</div>
            </div>
            <div class="cc-demo-foot"><span>Same project. Different conversation.</span><span data-cc-counter>01 / 03</span></div>
          </div>
        </div>
      </section>

      <section class="cc-section" id="how-it-works">
        <div class="hx-container">
          <div class="cc-section-heading">
            <p class="cc-eyebrow">How it works</p>
            <h2>Less explaining. More doing.</h2>
            <p>Three simple steps to keep ongoing work organized across conversations.</p>
          </div>
          <div class="cc-steps">
            {steps.map((step) => (
              <article class="cc-step">
                <span class="cc-step-number">{step.number}</span>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
                <blockquote>“{step.prompt}”</blockquote>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="cc-section cc-faq-section">
        <div class="hx-container cc-faq-grid">
          <div>
            <p class="cc-eyebrow">Good to know</p>
            <h2>Your work.<br/>Your context.</h2>
            <p>Context Commander saves project information you choose to submit, rather than automatically importing all your conversations.</p>
          </div>
          <div class="cc-faq">
            <details>
              <summary>Do I need Desktop Commander installed?</summary>
              <p>No. Context Commander is a separate hosted MCP for project memory. It does not require access to your computer or execute commands.</p>
            </details>
            <details>
              <summary>Can I use it in a different AI conversation?</summary>
              <p>Yes. Retrieve the same saved project from a new conversation using your account and an authorized, compatible MCP client. Tool availability and automatic retrieval depend on the AI application.</p>
            </details>
            <details>
              <summary>What exactly is stored?</summary>
              <p>Project names, goals, tasks, decisions, progress summaries, blockers and next steps submitted to Context Commander. Checkpoints describe reported progress; they do not verify that work was completed.</p>
            </details>
            <details>
              <summary>Can I delete my saved context?</summary>
              <p>Yes. Use the project deletion tool or contact support to request deletion or export. Contact <a href="mailto:support@desktopcommander.app">support</a> for details. The product-specific privacy policy will be available before launch.</p>
            </details>
          </div>
        </div>
      </section>

      <section class="cc-section cc-final">
        <div class="hx-container cc-final-inner">
          <h2>Keep moving, even when the chat ends.</h2>
          <p>Save the important parts of your work and resume when you're ready.</p>
          {connectUrl ? (
            <a class="cc-button" href={connectUrl}>Connect to ChatGPT <span aria-hidden="true">↗</span></a>
          ) : (
            <span class="cc-button cc-button-pending" aria-disabled="true">Coming soon</span>
          )}
        </div>
      </section>
    </main>

    <footer class="cc-footer">
      <div class="hx-container cc-footer-inner">
        <div><strong>Context Commander</strong><span> · Desktop Commander SIA</span></div>
        <nav aria-label="Context Commander legal and support">
          <!-- Replace with the product policy once legal PR #7 is approved and published. -->
          <a href="https://legal.desktopcommander.app/#/website_privacy_policy">Website privacy</a>
          <a href="https://legal.desktopcommander.app/#/terms_of_service_2026_11_09">Terms</a>
          <a href="mailto:support@desktopcommander.app">Support</a>
        </nav>
      </div>
    </footer>
  </div>
</Layout>

<style>
  .cc-page { min-height: 100vh; }
  .cc-header { border-bottom: 1px solid var(--hx-line); }
  .cc-header-inner, .cc-footer-inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; padding-block: 20px; }
  .cc-brand { display: inline-flex; gap: 12px; align-items: center; color: var(--hx-text); font-size: 1rem; font-weight: 650; text-decoration: none; letter-spacing: -.02em; }
  .cc-mark { display: grid; place-items: center; width: 40px; height: 40px; border: 1px solid var(--hx-line-hi); background: var(--hx-panel); border-radius: 12px; color: var(--hx-blue); }
  .cc-byline, .cc-caption { color: var(--hx-text-3); font-size: .875rem; }
  .cc-hero { position: relative; overflow: hidden; padding-block: clamp(70px, 11vw, 140px); }
  .cc-hero-grid { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,.9fr); align-items: center; gap: clamp(40px, 7vw, 100px); }
  .cc-kicker { display: inline-flex; gap: 9px; align-items: center; margin-bottom: 24px; font-size: .9rem; color: var(--hx-text-2); }
  .cc-kicker span, .cc-chat-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--hx-blue); box-shadow: 0 0 14px rgba(var(--hx-blue-rgb),.45); flex: 0 0 auto; }
  h1 { font-size: clamp(3rem, 5.8vw, 5.35rem); letter-spacing: -.065em; line-height: 1.03; font-weight: 680; margin: 0 0 24px; }
  h1 span { color: var(--hx-blue); }
  .cc-lead { font-size: clamp(1.05rem,1.8vw,1.25rem); line-height: 1.65; color: var(--hx-text-2); max-width: 560px; }
  .cc-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; margin: 32px 0 16px; }
  .cc-button { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 50px; padding: 0 23px; border-radius: 12px; background: var(--hx-blue); color: var(--hx-bg-deep); font-weight: 650; text-decoration: none; }
  a.cc-button:hover { background: var(--hx-blue-hi); }
  .cc-button-pending { background: var(--hx-panel-hi); border: 1px solid var(--hx-line-hi); color: var(--hx-text-2); }
  .cc-text-link { color: var(--hx-text); text-decoration: none; font-size: .95rem; font-weight: 550; }
  .cc-text-link:hover { color: var(--hx-blue); }
  .cc-visual { position: relative; isolation: isolate; max-width: 490px; width: 100%; margin-inline: auto; }
  .cc-visual::before { content: ''; position: absolute; inset: -10%; z-index: -1; background: radial-gradient(ellipse, rgba(var(--hx-blue-rgb),.14),transparent 68%); filter: blur(30px); }
  .cc-chat { padding: 0 20px 20px; background: var(--hx-panel); border: 1px solid var(--hx-line-hi); border-radius: 20px; box-shadow: 0 16px 70px rgba(0,0,0,.26); }
  .cc-chat-header { display: flex; align-items: center; gap: 9px; border-bottom: 1px solid var(--hx-line); margin: 0 -20px 18px; padding: 14px 20px; font-size: .8rem; color: var(--hx-text-2); }
  .cc-chat-header .cc-muted { margin-left: auto; color: var(--hx-text-3); }
  .cc-bubble { padding: 12px 14px; border-radius: 12px; font-size: .9rem; line-height: 1.55; }
  .cc-user { margin-left: 24px; background: var(--hx-panel-hi); color: var(--hx-text); }
  .cc-assistant { margin-top: 12px; padding-left: 0; padding-right: 0; color: var(--hx-text-2); }
  .cc-assistant strong { color: var(--hx-text); font-weight: 570; }
  .cc-project { border: 1px solid var(--hx-line-hi); border-radius: 12px; padding: 15px 16px; margin-top: 11px; background: var(--hx-bg-deep); }
  .cc-project-label { color: var(--hx-blue); font-size: .68rem; letter-spacing: .1em; font-weight: 650; }
  .cc-project h2 { margin: 6px 0 12px; color: var(--hx-text); font-size: 1.05rem; font-weight: 630; letter-spacing: -.02em; }
  .cc-line { display: flex; align-items: baseline; gap: 9px; margin-top: 6px; font-size: .82rem; }
  .cc-status { color: var(--hx-green); }.cc-next { color: var(--hx-blue); }
  .cc-transfer { display: flex; align-items: center; gap: 12px; justify-content: center; margin: 18px 22px; color: var(--hx-blue); font-size: .75rem; font-weight: 550; }
  .cc-transfer span { flex: 1; height: 1px; background: var(--hx-line-hi); }
  .cc-chat-resume .cc-assistant { margin-bottom: 0; padding-bottom: 0; }
  .cc-section { padding-block: clamp(60px,8vw,100px); border-top: 1px solid var(--hx-line); }
  .cc-section-heading { margin: 0 auto 36px; text-align: center; max-width: 620px; }
  .cc-eyebrow { color: var(--hx-blue); font-size: .85rem; font-weight: 650; margin-bottom: 10px; }
  .cc-section h2 { font-size: clamp(2rem,3.6vw,3.15rem); line-height: 1.12; letter-spacing: -.045em; font-weight: 650; margin-bottom: 16px; }
  .cc-section p { color: var(--hx-text-2); line-height: 1.65; }
  .cc-section p.cc-eyebrow { color: var(--hx-blue); }
  .cc-steps { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 18px; }
  .cc-step { display: flex; flex-direction: column; padding: 26px; border: 1px solid var(--hx-line); border-radius: 18px; background: var(--hx-panel); }
  .cc-step-number { font-size: .84rem; color: var(--hx-blue); font-family: var(--hx-mono); }
  .cc-step h3 { font-size: 1.25rem; letter-spacing: -.03em; font-weight: 620; margin: 22px 0 10px; }
  .cc-step p { font-size: .95rem; margin-bottom: 20px; }
  .cc-step blockquote { margin: auto 0 0; padding: 14px; background: var(--hx-bg-deep); border: 1px solid var(--hx-line); border-radius: 10px; font-size: .85rem; color: var(--hx-text); line-height: 1.5; }
  .cc-faq-grid { display: grid; grid-template-columns: minmax(0,.8fr) minmax(0,1.2fr); gap: clamp(30px,7vw,90px); }
  .cc-faq details { border-bottom: 1px solid var(--hx-line); }
  .cc-faq summary { cursor: pointer; padding: 18px 0; font-weight: 550; font-size: 1.02rem; }
  .cc-faq details:first-child summary { padding-top: 0; }
  .cc-faq p { padding-bottom: 20px; font-size: .95rem; }
  .cc-faq a { color: var(--hx-blue); text-decoration: underline; }
  .cc-final { text-align: center; background: var(--hx-bg-deep); }
  .cc-final-inner { max-width: 760px; }
  .cc-final .cc-button { margin-top: 24px; }
  .cc-footer { border-top: 1px solid var(--hx-line); }
  .cc-footer-inner { color: var(--hx-text-3); font-size: .85rem; }
  .cc-footer strong { color: var(--hx-text-2); font-weight: 550; }
  .cc-footer nav { display: flex; flex-wrap: wrap; gap: 20px; }
  .cc-footer a { color: var(--hx-text-2); text-decoration: none; }
  .cc-footer a:hover { color: var(--hx-blue); }
  @media (max-width: 900px) {
    .cc-hero-grid, .cc-faq-grid { grid-template-columns: 1fr; }
    .cc-visual { max-width: 540px; }
    .cc-copy { max-width: 640px; }
  }
  @media (max-width: 640px) {
    .cc-steps { grid-template-columns: 1fr; }
    .cc-header-inner { padding-block: 14px; }
    .cc-byline { font-size: .75rem; }
    .cc-desktop-break { display: none; }
    .cc-hero { padding-block: 64px; }
    .cc-chat { padding-inline: 15px; }
    .cc-chat-header { padding-inline: 15px; margin-inline: -15px; }
  }

  .cc-hero { padding-block: clamp(65px,8vw,105px); }
  .cc-hero::before { content:''; position:absolute; inset:0; pointer-events:none; background:radial-gradient(ellipse at 78% 43%,rgba(37,99,235,.14),transparent 52%); }
  .cc-hero-grid { position:relative; }
  .cc-copy h1 { font-size:clamp(3.2rem,6.1vw,5.9rem); }
  .cc-copy h1 span { background:linear-gradient(100deg,#a5c7ff,#5489f8); -webkit-background-clip:text; background-clip:text; color:transparent; }
  .cc-copy > * { animation:cc-enter .8s cubic-bezier(.22,1,.36,1) both; }
  .cc-copy > :nth-child(2){animation-delay:.10s}.cc-copy > :nth-child(3){animation-delay:.19s}.cc-copy > :nth-child(4){animation-delay:.28s}.cc-copy > :nth-child(5){animation-delay:.36s}
  @keyframes cc-enter {from{opacity:0;transform:translateY(19px)}to{opacity:1;transform:translateY(0)}}
  .cc-visual { max-width:540px; animation:cc-enter 1s .18s both; }
  .cc-demo-top,.cc-demo-foot { display:flex; align-items:center; justify-content:space-between; gap:12px; font-size:.72rem; color:var(--hx-text-3); font-family:var(--hx-mono); }
  .cc-demo-top { margin:0 0 12px; }.cc-demo-foot { margin-top:13px; }
  .cc-demo-live {display:inline-flex;align-items:center;gap:7px;color:var(--hx-text-2)}
  .cc-demo-live i {width:7px;height:7px;border-radius:50%;background:var(--hx-green);box-shadow:0 0 12px var(--hx-green)}
  .cc-demo-top button { border:1px solid var(--hx-line-hi); padding:5px 13px; border-radius:7px; color:var(--hx-text-2); }
  .cc-scenario-tabs {display:flex; gap:6px; margin-bottom:12px; padding:4px; background:var(--hx-bg-deep);border:1px solid var(--hx-line);border-radius:11px}
  .cc-scenario-tabs button { flex:1; padding:9px 6px; border-radius:7px; font-size:.78rem; color:var(--hx-text-3); transition:background .2s,color .2s; }
  .cc-scenario-tabs button[aria-pressed="true"] {background:var(--hx-panel-hi);color:var(--hx-text);box-shadow:0 0 0 1px var(--hx-line-hi)}
  .cc-chat { padding-bottom:14px;border-radius:15px;transition:opacity .45s,border-color .45s,transform .45s; }
  .cc-chat-header { padding-block:11px;margin-bottom:12px; }.cc-chat-header img{width:20px;height:20px;object-fit:contain}
  .cc-chat-header img[src*="chatgpt"] {filter:brightness(0) invert(1)}
  .cc-bubble {font-size:.84rem; padding:10px 12px}.cc-assistant {padding-left:0;padding-right:0;margin-top:7px}
  .cc-wire {height:38px;display:flex;align-items:center;justify-content:center;position:relative;overflow:hidden}
  .cc-wire::before {content:'';height:100%;width:1px;background:var(--hx-line-hi);position:absolute;left:50%}
  .cc-wire span {position:relative;margin-left:140px;font: .66rem var(--hx-mono);color:var(--hx-text-3)}
  .cc-wire i {position:absolute;left:calc(50% - 2px);width:5px;height:13px;border-radius:8px;background:#b6d6ff;box-shadow:0 0 12px 4px #548bfc;opacity:0;top:0}
  .cc-wire.is-active i {animation:cc-signal .75s linear both}
  @keyframes cc-signal {0%{transform:translateY(-12px);opacity:0}20%{opacity:1}80%{opacity:1}100%{transform:translateY(40px);opacity:0}}
  .cc-memory {padding:15px 17px;border:1px solid rgba(var(--hx-blue-rgb),.35);border-radius:16px;background:linear-gradient(135deg,var(--hx-panel),var(--hx-bg-deep));box-shadow:0 0 32px rgba(var(--hx-blue-rgb),.08);transition:opacity .45s,border-color .45s,box-shadow .45s}
  .cc-memory-head {display:flex;align-items:center;gap:10px}
  .cc-memory-mark {width:36px;height:36px;font-size:23px;color:var(--hx-blue);border-color:rgba(var(--hx-blue-rgb),.25)}
  .cc-memory-head strong {font-size:.9rem;font-weight:650}.cc-memory-head small {display:block;color:var(--hx-text-3);font-size:.7rem;margin-top:2px}
  .cc-saved {margin-left:auto;font:.7rem var(--hx-mono);color:var(--hx-green);white-space:nowrap}
  .cc-memory .cc-project {margin-top:12px;padding:11px 13px}.cc-memory .cc-project h2{margin:4px 0 8px}
  .cc-memory.is-writing {border-color:var(--hx-blue);box-shadow:0 0 30px rgba(var(--hx-blue-rgb),.25)}
  .cc-visual[data-phase="0"] .cc-memory,.cc-visual[data-phase="0"] .cc-chat-resume {opacity:.48}
  .cc-visual[data-phase="1"] .cc-chat-resume,.cc-visual[data-phase="2"] .cc-chat-resume {opacity:.5}
  .cc-visual[data-phase="3"] .cc-chat-resume {border-color:rgba(var(--hx-blue-rgb),.5);transform:translateY(-2px)}
  .cc-visual[data-phase="3"] .cc-assistant {animation:cc-enter .45s both}
  .cc-step {transition:transform .25s,border-color .25s,box-shadow .25s}
  .cc-step:hover {transform:translateY(-4px);border-color:rgba(var(--hx-blue-rgb),.35);box-shadow:0 12px 36px rgba(0,0,0,.2)}
  .cc-section.cc-reveal-ready .cc-step,.cc-section.cc-reveal-ready .cc-section-heading,.cc-section.cc-reveal-ready .cc-faq-grid,.cc-section.cc-reveal-ready .cc-final-inner {opacity:0;transform:translateY(20px)}
  .cc-section.cc-reveal-ready.is-in .cc-step,.cc-section.cc-reveal-ready.is-in .cc-section-heading,.cc-section.cc-reveal-ready.is-in .cc-faq-grid,.cc-section.cc-reveal-ready.is-in .cc-final-inner {animation:cc-enter .65s both}
  .cc-section.is-in .cc-step:nth-child(2){animation-delay:.11s}.cc-section.is-in .cc-step:nth-child(3){animation-delay:.22s}
  @media(max-width:640px){.cc-copy h1{font-size:clamp(2.8rem,12vw,4rem)}.cc-wire{height:34px}.cc-memory{padding:12px}.cc-demo-top button{min-height:36px}}
  @media(prefers-reduced-motion:reduce){.cc-page *{animation:none!important;transition:none!important}.cc-section.cc-reveal-ready .cc-step,.cc-section.cc-reveal-ready .cc-section-heading,.cc-section.cc-reveal-ready .cc-faq-grid,.cc-section.cc-reveal-ready .cc-final-inner{opacity:1;transform:none}.cc-visual .cc-chat,.cc-visual .cc-memory{opacity:1!important}}

</style>
<script>
  const examples = [
    {prompt:'Save where we stopped on the website redesign.',project:'Website redesign',done:'Homepage wireframes finished',decision:'Decision: simplify navigation',next:'Next: build the pricing page',resume:"Let's continue the website redesign.",answer:"You're ready to build the pricing page. The wireframes are finished and the navigation decision is saved.",client:'Claude',icon:'/agents/claude.svg'},
    {prompt:'Remember what we learned about the market.',project:'Market research',done:'Reviewed 12 competitor products',decision:'Decision: focus on small teams',next:'Next: interview five potential users',resume:'What was next for our market research?',answer:"We narrowed the audience to small teams. Next, interview five potential users to validate the problem.",client:'ChatGPT',icon:'/agents/chatgpt.svg'},
    {prompt:'Save the decisions from our launch planning.',project:'Product launch',done:'Launch messaging drafted',decision:'Decision: start with a small beta',next:'Next: prepare onboarding emails',resume:'Pick up the product launch plan.',answer:"The messaging is drafted and we're starting with a small beta. Let's prepare the onboarding emails.",client:'Claude',icon:'/agents/claude.svg'},
  ];
  const demo = document.querySelector<HTMLElement>('[data-cc-demo]');
  if(demo){
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const tabs = Array.from(demo.querySelectorAll<HTMLButtonElement>('[data-cc-scenario]'));
    const pause = demo.querySelector<HTMLButtonElement>('[data-cc-pause]')!;
    const memory = demo.querySelector<HTMLElement>('[data-cc-memory]')!;
    const save = demo.querySelector<HTMLElement>('[data-cc-wire="save"]')!;
    const resume = demo.querySelector<HTMLElement>('[data-cc-wire="resume"]')!;
    let current = 0, phase = 0, manualPause = reduced, visible = false;
    let timer: ReturnType<typeof setTimeout> | undefined;
    function set(key:string,value:string){const node=demo!.querySelector<HTMLElement>('[data-cc-'+key+']');if(node)node.textContent=value;}
    function render(index:number){
      current=index;const e=examples[index];
      for(const k of ['prompt','project','done','decision','next','resume','answer','client'] as const)set(k,e[k]);
      demo!.querySelector<HTMLImageElement>('[data-cc-client-icon]')!.src=e.icon;
      set('counter',String(index+1).padStart(2,'0')+' / 03');
      tabs.forEach((t,i)=>t.setAttribute('aria-pressed',String(i===index)));
    }
    function showPhase(p:number){
      phase=p;demo!.dataset.phase=String(p);
      save.classList.toggle('is-active',p===1);
      resume.classList.toggle('is-active',p===3);
      memory.classList.toggle('is-writing',p===1||p===2);
      set('status',p===0?'Ready':p===1?'Saving…':'✓ Saved');
      set('action',p===0?'save_checkpoint':p===1?'Saving checkpoint…':'save_checkpoint ✓');
    }
    function schedule(){
      clearTimeout(timer);
      if(manualPause||!visible||document.hidden)return;
      timer=setTimeout(()=>{
        if(phase===3){render((current+1)%examples.length);showPhase(0);}
        else showPhase(phase+1);
        schedule();
      },[1400,950,950,4000][phase]);
    }
    tabs.forEach((tab,i)=>tab.addEventListener('click',()=>{
      render(i);showPhase(manualPause?3:0);schedule();
    }));
    pause.addEventListener('click',()=>{
      manualPause=!manualPause;pause.textContent=manualPause?'Play':'Pause';
      pause.setAttribute('aria-pressed',String(manualPause));if(manualPause)showPhase(3);else showPhase(0);schedule();
    });
    pause.textContent=manualPause?'Play':'Pause';pause.setAttribute('aria-pressed',String(manualPause));
    render(0);showPhase(manualPause?3:0);
    new IntersectionObserver(entries=>{visible=entries[0].isIntersecting;schedule();},{threshold:.2}).observe(demo);
    document.addEventListener('visibilitychange',schedule);
    if(!reduced){
      const observer=new IntersectionObserver(entries=>{for(const entry of entries){if(entry.isIntersecting){entry.target.classList.add('is-in');observer.unobserve(entry.target);}}},{threshold:.1});
      document.querySelectorAll('.cc-section').forEach(section=>{section.classList.add('cc-reveal-ready');observer.observe(section);});
    }
  }
</script>
