---
import Layout from '../layouts/Layout.astro';
import PostHogInit from '../../src/components/PostHogInit';
import Navigation from '../components/Navigation.astro';
import PricingSection from '../../src/components/PricingSection';
import PricingFAQ from '../../src/components/PricingFAQ';
import Footer from '../../src/components/Footer';
---

<Layout
  title="Pricing Preview - Desktop Commander"
  description="Preview of the updated Desktop Commander pricing. Start free with 200 messages per week. Go Pro from $7/month or get Pro + Credits from $20/month."
>
  <!-- Load PostHog early to initialize analytics -->
  <PostHogInit client:load />

  <div class="min-h-screen bg-background">
    <Navigation />
    <main>
      <PricingSection client:load includeTwoHundredDollarPackage={false} />
      <PricingFAQ client:visible />
    </main>
    <Footer client:visible />
  </div>
</Layout>

<style is:global>
  @import '../../src/index.css';
</style>
