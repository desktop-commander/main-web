---
import Layout from '../../../layouts/Layout.astro';
import PostHogInit from '../../../../src/components/PostHogInit';
import Navigation from '../../../components/Navigation.astro';
import KnowledgeManagementHero from '../../../../src/components/use-cases/knowledge-management/KnowledgeManagementHero';
import KMProblemSection from '../../../../src/components/use-cases/knowledge-management/KMProblemSection';
import KMSolutionSection from '../../../../src/components/use-cases/knowledge-management/KMSolutionSection';
import KMWhyDifferentSection from '../../../../src/components/use-cases/knowledge-management/KMWhyDifferentSection';
import KMWhyMarkdownSection from '../../../../src/components/use-cases/knowledge-management/KMWhyMarkdownSection';
import KMToolsSection from '../../../../src/components/use-cases/knowledge-management/KMToolsSection';
import KMGitNativeSection from '../../../../src/components/use-cases/knowledge-management/KMGitNativeSection';
import KMPersonasSection from '../../../../src/components/use-cases/knowledge-management/KMPersonasSection';
import HowItWorks from '../../../../src/components/home-mcp/HowItWorks';
import ClientFAQ from '../../../../src/components/mcp/clients/ClientFAQ';
import InstallChooser from '../../../../src/components/home-mcp/InstallChooser';
import Footer from '../../../../src/components/Footer';
import { faqJsonLd } from '../../../../src/components/use-cases/remote/faqs';
import { KNOWLEDGE_MANAGEMENT_FAQS } from '../../../../src/components/use-cases/remote/faqs/knowledge-management';
---

<Layout 
  title="Chat With Your Notes in ChatGPT or Claude | Desktop Commander"
  description="Turn your markdown notes and docs into an AI knowledge base. Ask ChatGPT or Claude to write, edit, and link the notes on your Mac or Windows PC."
  jsonLd={faqJsonLd(KNOWLEDGE_MANAGEMENT_FAQS)}
>
  <PostHogInit client:idle />
  
  <div class="min-h-screen bg-background">
    <Navigation />
    
    <main>
      <KnowledgeManagementHero client:load />
      <KMProblemSection />
      <KMSolutionSection />
      <KMWhyDifferentSection />
      <KMWhyMarkdownSection />
      <KMToolsSection />
      <KMGitNativeSection />
      <KMPersonasSection />
      <!-- Remote MCP setup: same steps as the homepage -->
      <HowItWorks client:visible />
      <ClientFAQ client:visible name="Knowledge management" heading="Knowledge management FAQ" faqs={KNOWLEDGE_MANAGEMENT_FAQS} />
      <!-- #install target for the hero button; same chooser as the homepage -->
      <InstallChooser
        client:visible
        location="knowledge_management_install"
        heading="Stop copying notes into the chat"
        sub="Add Desktop Commander to ChatGPT or Claude, link your computer, and turn your conversations into notes you keep."
      />
    </main>
    
    <Footer client:visible />
  </div>
</Layout>

<style is:global>
  @import '../../../../src/index.css';
</style>
