---
import Layout from '../../../layouts/Layout.astro';
import PostHogInit from '../../../../src/components/PostHogInit';
import Navigation from '../../../components/Navigation.astro';
import CAHeroSection from '../../../../src/components/use-cases/connect-apps/CAHeroSection';
import CAProblemSection from '../../../../src/components/use-cases/connect-apps/CAProblemSection';
import CASolutionSection from '../../../../src/components/use-cases/connect-apps/CASolutionSection';
import CAWorkflowChainsSection from '../../../../src/components/use-cases/connect-apps/CAWorkflowChainsSection';
import CAExamplesSection from '../../../../src/components/use-cases/connect-apps/CAExamplesSection';
import CAComparisonSection from '../../../../src/components/use-cases/connect-apps/CAComparisonSection';
import HowItWorks from '../../../../src/components/home-mcp/HowItWorks';
import CAPersonasSection from '../../../../src/components/use-cases/connect-apps/CAPersonasSection';
import ClientFAQ from '../../../../src/components/mcp/clients/ClientFAQ';
import InstallChooser from '../../../../src/components/home-mcp/InstallChooser';
import Footer from '../../../../src/components/Footer';
import { faqJsonLd } from '../../../../src/components/use-cases/remote/faqs';
import { CONNECT_APPS_FAQS } from '../../../../src/components/use-cases/remote/faqs/connect-apps';
---

<Layout 
  title="Connect Your Apps With AI in ChatGPT or Claude | Desktop Commander"
  description="Ask ChatGPT or Claude to work with your tools from the terminal on your Mac or Windows PC: call APIs with your own keys, run CLIs like git, and run your scripts."
  jsonLd={faqJsonLd(CONNECT_APPS_FAQS)}
>
  <PostHogInit client:idle />
  
  <div class="min-h-screen bg-background">
    <Navigation />
    
    <main>
      <CAHeroSection client:load />
      <CAProblemSection />
      <CASolutionSection />
      <CAWorkflowChainsSection />
      <CAExamplesSection />
      <CAComparisonSection />
      <!-- Remote MCP setup: same steps as the homepage -->
      <HowItWorks client:visible />
      <CAPersonasSection />
      <ClientFAQ client:visible name="Connect apps" heading="Connect apps FAQ" faqs={CONNECT_APPS_FAQS} />
      <!-- #install target for the hero button; same chooser as the homepage -->
      <InstallChooser
        client:visible
        location="connect_apps_install"
        heading="Work with your tools from one chat"
        sub="Add Desktop Commander to the assistant you already use, link your computer, and ask it to work with your tools from the terminal."
      />
    </main>
    
    <Footer client:visible />
  </div>
</Layout>

<style is:global>
  @import '../../../../src/index.css';
</style>
