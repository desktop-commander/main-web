---
import Layout from '../../../../layouts/Layout.astro';
import PostHogInit from '../../../../../src/components/PostHogInit';
import Navigation from '../../../../components/Navigation.astro';
import AJHeroSection from '../../../../../src/components/use-cases/file-management/avif-to-jpg/AJHeroSection';
import AJProblemSection from '../../../../../src/components/use-cases/file-management/avif-to-jpg/AJProblemSection';
import AJSolutionSection from '../../../../../src/components/use-cases/file-management/avif-to-jpg/AJSolutionSection';
import AJComparisonSection from '../../../../../src/components/use-cases/file-management/avif-to-jpg/AJComparisonSection';
import AJPersonasSection from '../../../../../src/components/use-cases/file-management/avif-to-jpg/AJPersonasSection';
import HowItWorks from '../../../../../src/components/home-mcp/HowItWorks';
import ClientFAQ from '../../../../../src/components/mcp/clients/ClientFAQ';
import InstallChooser from '../../../../../src/components/home-mcp/InstallChooser';
import Footer from '../../../../../src/components/Footer';
import MoreConversions from '../../../../components/MoreConversions.astro';
import { faqJsonLd } from '../../../../../src/components/use-cases/remote/faqs';
import { AVIF_TO_JPG_FAQS } from '../../../../../src/components/use-cases/remote/faqs/avif-to-jpg';
---

<Layout 
  title="Convert AVIF to JPG with ChatGPT or Claude | Desktop Commander"
  description="Convert AVIF images to JPG on your Mac or Windows PC by asking ChatGPT or Claude. Convert a whole folder in one message, with no converter websites."
  jsonLd={faqJsonLd(AVIF_TO_JPG_FAQS)}
>
  <PostHogInit client:idle />
  
  <div class="min-h-screen bg-background">
    <Navigation />
    
    <main>
      <AJHeroSection client:load />
      <AJProblemSection />
      <AJSolutionSection />
      <AJComparisonSection />
      <HowItWorks client:visible />
      <AJPersonasSection />
      <ClientFAQ client:visible name="AVIF to JPG" heading="AVIF to JPG FAQ" faqs={AVIF_TO_JPG_FAQS} />
      <InstallChooser
        client:visible
        location="avif_to_jpg_install"
        heading="Convert a whole folder of AVIF images in one message"
        sub="Add Desktop Commander to the assistant you already use and convert AVIF to JPG from the chat."
      />
    </main>
    
    <MoreConversions current="avif-to-jpg" />
    <Footer client:visible />
  </div>
</Layout>

<style is:global>
  @import '../../../../../src/index.css';
</style>
