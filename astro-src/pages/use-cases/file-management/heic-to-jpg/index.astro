---
import Layout from '../../../../layouts/Layout.astro';
import PostHogInit from '../../../../../src/components/PostHogInit';
import Navigation from '../../../../components/Navigation.astro';
import HJHeroSection from '../../../../../src/components/use-cases/file-management/heic-to-jpg/HJHeroSection';
import HJProblemSection from '../../../../../src/components/use-cases/file-management/heic-to-jpg/HJProblemSection';
import HJSolutionSection from '../../../../../src/components/use-cases/file-management/heic-to-jpg/HJSolutionSection';
import HJComparisonSection from '../../../../../src/components/use-cases/file-management/heic-to-jpg/HJComparisonSection';
import HJPersonasSection from '../../../../../src/components/use-cases/file-management/heic-to-jpg/HJPersonasSection';
import HowItWorks from '../../../../../src/components/home-mcp/HowItWorks';
import ClientFAQ from '../../../../../src/components/mcp/clients/ClientFAQ';
import InstallChooser from '../../../../../src/components/home-mcp/InstallChooser';
import Footer from '../../../../../src/components/Footer';
import MoreConversions from '../../../../components/MoreConversions.astro';
import { HEIC_TO_JPG_FAQS, faqJsonLd } from '../../../../../src/components/use-cases/remote/faqs';
---

<Layout 
  title="Batch Convert HEIC to JPG with ChatGPT or Claude | Desktop Commander"
  description="Batch convert HEIC to JPG on your Mac or Windows PC by asking ChatGPT or Claude. Convert a whole folder of iPhone photos in one message."
  jsonLd={faqJsonLd(HEIC_TO_JPG_FAQS)}
>
  <PostHogInit client:idle />
  
  <div class="min-h-screen bg-background">
    <Navigation />
    
    <main>
      <HJHeroSection client:load />
      <HJProblemSection />
      <HJSolutionSection />
      <HJComparisonSection />
      <HowItWorks client:visible />
      <HJPersonasSection />
      <ClientFAQ client:visible name="HEIC to JPG" heading="HEIC to JPG FAQ" faqs={HEIC_TO_JPG_FAQS} />
      <InstallChooser
        client:visible
        location="heic_to_jpg_install"
        heading="Convert a whole folder in one message"
        sub="Add Desktop Commander to the assistant you already use and convert HEIC to JPG from the chat."
      />
    </main>
    
    <MoreConversions current="heic-to-jpg" />
    <Footer client:visible />
  </div>
</Layout>

<style is:global>
  @import '../../../../../src/index.css';
</style>
