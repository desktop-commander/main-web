---
import Layout from '../../../../layouts/Layout.astro';
import PostHogInit from '../../../../../src/components/PostHogInit';
import Navigation from '../../../../components/Navigation.astro';
import TJHeroSection from '../../../../../src/components/use-cases/file-management/tiff-to-jpg/TJHeroSection';
import TJProblemSection from '../../../../../src/components/use-cases/file-management/tiff-to-jpg/TJProblemSection';
import TJSolutionSection from '../../../../../src/components/use-cases/file-management/tiff-to-jpg/TJSolutionSection';
import TJComparisonSection from '../../../../../src/components/use-cases/file-management/tiff-to-jpg/TJComparisonSection';
import TJPersonasSection from '../../../../../src/components/use-cases/file-management/tiff-to-jpg/TJPersonasSection';
import HowItWorks from '../../../../../src/components/home-mcp/HowItWorks';
import ClientFAQ from '../../../../../src/components/mcp/clients/ClientFAQ';
import InstallChooser from '../../../../../src/components/home-mcp/InstallChooser';
import Footer from '../../../../../src/components/Footer';
import MoreConversions from '../../../../components/MoreConversions.astro';
import { faqJsonLd } from '../../../../../src/components/use-cases/remote/faqs';
import { TIFF_TO_JPG_FAQS } from '../../../../../src/components/use-cases/remote/faqs/tiff-to-jpg';
---

<Layout 
  title="Batch Convert TIFF to JPG with ChatGPT or Claude | Desktop Commander"
  description="Batch convert TIFF scans and print files to JPG on your Mac or Windows PC by asking ChatGPT or Claude. Convert a whole folder in one message."
  jsonLd={faqJsonLd(TIFF_TO_JPG_FAQS)}
>
  <PostHogInit client:idle />
  
  <div class="min-h-screen bg-background">
    <Navigation />
    
    <main>
      <TJHeroSection client:load />
      <TJProblemSection />
      <TJSolutionSection />
      <TJComparisonSection />
      <HowItWorks client:visible />
      <TJPersonasSection />
      <ClientFAQ client:visible name="TIFF to JPG" heading="TIFF to JPG FAQ" faqs={TIFF_TO_JPG_FAQS} />
      <InstallChooser
        client:visible
        location="tiff_to_jpg_install"
        heading="Convert a whole folder of TIFFs in one message"
        sub="Add Desktop Commander to the assistant you already use and convert TIFF to JPG from the chat."
      />
    </main>
    
    <MoreConversions current="tiff-to-jpg" />
    <Footer client:visible />
  </div>
</Layout>

<style is:global>
  @import '../../../../../src/index.css';
</style>
