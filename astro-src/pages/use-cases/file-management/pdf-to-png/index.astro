---
import Layout from '../../../../layouts/Layout.astro';
import PostHogInit from '../../../../../src/components/PostHogInit';
import Navigation from '../../../../components/Navigation.astro';
import PPHeroSection from '../../../../../src/components/use-cases/file-management/pdf-to-png/PPHeroSection';
import PPProblemSection from '../../../../../src/components/use-cases/file-management/pdf-to-png/PPProblemSection';
import PPSolutionSection from '../../../../../src/components/use-cases/file-management/pdf-to-png/PPSolutionSection';
import PPComparisonSection from '../../../../../src/components/use-cases/file-management/pdf-to-png/PPComparisonSection';
import PPPersonasSection from '../../../../../src/components/use-cases/file-management/pdf-to-png/PPPersonasSection';
import HowItWorks from '../../../../../src/components/home-mcp/HowItWorks';
import ClientFAQ from '../../../../../src/components/mcp/clients/ClientFAQ';
import InstallChooser from '../../../../../src/components/home-mcp/InstallChooser';
import Footer from '../../../../../src/components/Footer';
import MoreConversions from '../../../../components/MoreConversions.astro';
import { faqJsonLd } from '../../../../../src/components/use-cases/remote/faqs';
import { PDF_TO_PNG_FAQS } from '../../../../../src/components/use-cases/remote/faqs/pdf-to-png';
---

<Layout 
  title="Convert PDF to PNG with ChatGPT or Claude | Desktop Commander"
  description="Convert PDF pages to PNG images on your Mac or Windows PC by asking ChatGPT or Claude. Pick single pages or convert a whole folder of PDFs in one message."
  jsonLd={faqJsonLd(PDF_TO_PNG_FAQS)}
>
  <PostHogInit client:idle />
  
  <div class="min-h-screen bg-background">
    <Navigation />
    
    <main>
      <PPHeroSection client:load />
      <PPProblemSection />
      <PPSolutionSection />
      <PPComparisonSection />
      <HowItWorks client:visible />
      <PPPersonasSection />
      <ClientFAQ client:visible name="PDF to PNG" heading="PDF to PNG FAQ" faqs={PDF_TO_PNG_FAQS} />
      <InstallChooser
        client:visible
        location="pdf_to_png_install"
        heading="Turn PDFs into shareable images"
        sub="Add Desktop Commander to the assistant you already use and convert PDF pages to PNG from the chat."
      />
    </main>
    
    <MoreConversions current="pdf-to-png" />
    <Footer client:visible />
  </div>
</Layout>

<style is:global>
  @import '../../../../../src/index.css';
</style>
