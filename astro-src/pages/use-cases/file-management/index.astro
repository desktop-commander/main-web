---
import Layout from '../../../layouts/Layout.astro';
import PostHogInit from '../../../../src/components/PostHogInit';
import Navigation from '../../../components/Navigation.astro';
import FileManagementHero from '../../../../src/components/use-cases/FileManagementHero';
import ProblemSection from '../../../../src/components/use-cases/ProblemSection';
import SolutionSection from '../../../../src/components/use-cases/SolutionSection';
import HowItWorks from '../../../../src/components/home-mcp/HowItWorks';
import TestimonialsSection from '../../../../src/components/use-cases/TestimonialsSection';
import ClientFAQ from '../../../../src/components/mcp/clients/ClientFAQ';
import InstallChooser from '../../../../src/components/home-mcp/InstallChooser';
import FMPopularConversions from '../../../../src/components/use-cases/file-management/FMPopularConversions';
import Footer from '../../../../src/components/Footer';
import { FILE_MANAGEMENT_FAQS, faqJsonLd } from '../../../../src/components/use-cases/remote/faqs';
---

<Layout 
  title="Manage Your Files With Chat in ChatGPT or Claude | Desktop Commander"
  description="Organize, convert, and rename the files on your Mac or Windows PC by asking ChatGPT or Claude. One message instead of a dozen manual steps."
  jsonLd={faqJsonLd(FILE_MANAGEMENT_FAQS)}
>
  <!-- Load PostHog early to initialize analytics -->
  <PostHogInit client:idle />
  
  <div class="min-h-screen bg-background">
    <Navigation />
    
    <main>
      <FileManagementHero client:load />
      
      <!-- Popular Conversions - High visibility for SEO -->
      <FMPopularConversions client:load />
      
      <ProblemSection />
      
      <SolutionSection />
      
      <!-- Remote MCP setup: same steps as the homepage -->
      <HowItWorks client:visible />
      
      <TestimonialsSection />
      
      <ClientFAQ client:visible name="File management" heading="File management FAQ" faqs={FILE_MANAGEMENT_FAQS} />
      
      <!-- #install target for the hero button; same chooser as the homepage -->
      <InstallChooser
        client:visible
        location="file_management_install"
        heading="Managing files should be simple"
        sub="Add Desktop Commander to the assistant you already use, link your computer, and ask for what you need."
      />
    </main>
    
    <Footer client:visible />
  </div>
</Layout>

<style is:global>
  @import '../../../../src/index.css';
</style>
