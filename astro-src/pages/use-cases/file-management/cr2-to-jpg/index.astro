---
import Layout from '../../../../layouts/Layout.astro';
import PostHogInit from '../../../../../src/components/PostHogInit';
import Navigation from '../../../../components/Navigation.astro';
import CRHeroSection from '../../../../../src/components/use-cases/file-management/cr2-to-jpg/CRHeroSection';
import CRProblemSection from '../../../../../src/components/use-cases/file-management/cr2-to-jpg/CRProblemSection';
import CRSolutionSection from '../../../../../src/components/use-cases/file-management/cr2-to-jpg/CRSolutionSection';
import CRComparisonSection from '../../../../../src/components/use-cases/file-management/cr2-to-jpg/CRComparisonSection';
import CRPersonasSection from '../../../../../src/components/use-cases/file-management/cr2-to-jpg/CRPersonasSection';
import HowItWorks from '../../../../../src/components/home-mcp/HowItWorks';
import ClientFAQ from '../../../../../src/components/mcp/clients/ClientFAQ';
import InstallChooser from '../../../../../src/components/home-mcp/InstallChooser';
import Footer from '../../../../../src/components/Footer';
import MoreConversions from '../../../../components/MoreConversions.astro';
import { faqJsonLd } from '../../../../../src/components/use-cases/remote/faqs';
import { CR2_TO_JPG_FAQS } from '../../../../../src/components/use-cases/remote/faqs/cr2-to-jpg';
---

<Layout 
  title="Convert Canon CR2 to JPG with ChatGPT or Claude | Desktop Commander"
  description="Batch convert Canon CR2 RAW photos to JPG on your Mac or Windows PC by asking ChatGPT or Claude. Convert a whole shoot in one message."
  jsonLd={faqJsonLd(CR2_TO_JPG_FAQS)}
>
  <PostHogInit client:idle />
  
  <div class="min-h-screen bg-background">
    <Navigation />
    
    <main>
      <CRHeroSection client:load />
      <CRProblemSection />
      <CRSolutionSection />
      <CRComparisonSection />
      <HowItWorks client:visible />
      <CRPersonasSection />
      <ClientFAQ client:visible name="CR2 to JPG" heading="CR2 to JPG FAQ" faqs={CR2_TO_JPG_FAQS} />
      <InstallChooser
        client:visible
        location="cr2_to_jpg_install"
        heading="Stop fighting with your RAW files."
        sub="Add Desktop Commander to the assistant you already use and convert CR2 to JPG from the chat."
      />
    </main>
    
    <MoreConversions current="cr2-to-jpg" />
    <Footer client:visible />
  </div>
</Layout>

<style is:global>
  @import '../../../../../src/index.css';
</style>
