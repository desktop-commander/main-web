---
import Layout from '../../../layouts/Layout.astro';
import PostHogInit from '../../../../src/components/PostHogInit';
import Navigation from '../../../components/Navigation.astro';
import BPHeroSection from '../../../../src/components/use-cases/build-prototype/BPHeroSection';
import BPProblemSection from '../../../../src/components/use-cases/build-prototype/BPProblemSection';
import BPSolutionSection from '../../../../src/components/use-cases/build-prototype/BPSolutionSection';
import BPExamplesSection from '../../../../src/components/use-cases/build-prototype/BPExamplesSection';
import BPWhyDifferentSection from '../../../../src/components/use-cases/build-prototype/BPWhyDifferentSection';
import BPComparisonSection from '../../../../src/components/use-cases/build-prototype/BPComparisonSection';
import BPCloudComparisonSection from '../../../../src/components/use-cases/build-prototype/BPCloudComparisonSection';
import HowItWorks from '../../../../src/components/home-mcp/HowItWorks';
import BPPersonasSection from '../../../../src/components/use-cases/build-prototype/BPPersonasSection';
import ClientFAQ from '../../../../src/components/mcp/clients/ClientFAQ';
import InstallChooser from '../../../../src/components/home-mcp/InstallChooser';
import Footer from '../../../../src/components/Footer';
import { faqJsonLd } from '../../../../src/components/use-cases/remote/faqs';
import { BUILD_PROTOTYPE_FAQS } from '../../../../src/components/use-cases/remote/faqs/build-prototype';
---

<Layout 
  title="Vibe-Code Your Next App With ChatGPT or Claude | Desktop Commander"
  description="An AI app builder in ChatGPT or Claude. Describe what you want and it writes the code in a real project on your computer, runs your dev server and handles Git."
  jsonLd={faqJsonLd(BUILD_PROTOTYPE_FAQS)}
>
  <PostHogInit client:idle />
  
  <div class="min-h-screen bg-background">
    <Navigation />
    
    <main>
      <BPHeroSection client:load />
      <BPProblemSection />
      <BPSolutionSection />
      <BPExamplesSection />
      <BPWhyDifferentSection />
      <BPCloudComparisonSection />
      <BPComparisonSection />
      <!-- Remote MCP setup: same steps as the homepage -->
      <HowItWorks client:visible />
      <BPPersonasSection />
      <ClientFAQ client:visible name="Building prototypes" heading="Building prototypes FAQ" faqs={BUILD_PROTOTYPE_FAQS} />
      <!-- #install target for the hero button; same chooser as the homepage -->
      <InstallChooser
        client:visible
        location="build_prototype_install"
        heading="Build your next app from the chat"
        sub="Add Desktop Commander to ChatGPT or Claude, link your computer, and describe what you want to build."
      />
    </main>
    
    <Footer client:visible />
  </div>
</Layout>

<style is:global>
  @import '../../../../src/index.css';
</style>
