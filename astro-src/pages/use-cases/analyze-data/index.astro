---
import Layout from '../../../layouts/Layout.astro';
import PostHogInit from '../../../../src/components/PostHogInit';
import Navigation from '../../../components/Navigation.astro';
import ADHeroSection from '../../../../src/components/use-cases/analyze-data/ADHeroSection';
import ADProblemSection from '../../../../src/components/use-cases/analyze-data/ADProblemSection';
import ADSolutionSection from '../../../../src/components/use-cases/analyze-data/ADSolutionSection';
import ADExamplesSection from '../../../../src/components/use-cases/analyze-data/ADExamplesSection';
import ADComparisonSection from '../../../../src/components/use-cases/analyze-data/ADComparisonSection';
import ADWhyDifferentSection from '../../../../src/components/use-cases/analyze-data/ADWhyDifferentSection';
import HowItWorks from '../../../../src/components/home-mcp/HowItWorks';
import ADPersonasSection from '../../../../src/components/use-cases/analyze-data/ADPersonasSection';
import ClientFAQ from '../../../../src/components/mcp/clients/ClientFAQ';
import InstallChooser from '../../../../src/components/home-mcp/InstallChooser';
import Footer from '../../../../src/components/Footer';
import { faqJsonLd } from '../../../../src/components/use-cases/remote/faqs';
import { ANALYZE_DATA_FAQS } from '../../../../src/components/use-cases/remote/faqs/analyze-data';
---

<Layout 
  title="Chat With Your Data in ChatGPT or Claude | Desktop Commander"
  description="Analyze CSV, Excel and JSON files on your Mac or Windows PC by asking ChatGPT or Claude. Find patterns, get real numbers and build reports without learning Python."
  jsonLd={faqJsonLd(ANALYZE_DATA_FAQS)}
>
  <PostHogInit client:idle />
  
  <div class="min-h-screen bg-background">
    <Navigation />
    
    <main>
      <ADHeroSection client:load />
      <ADProblemSection />
      <ADSolutionSection />
      <ADExamplesSection />
      <ADComparisonSection />
      <ADWhyDifferentSection />
      <!-- Remote MCP setup: same steps as the homepage -->
      <HowItWorks client:visible />
      <ADPersonasSection />
      <ClientFAQ client:visible name="Data analysis" heading="Data analysis FAQ" faqs={ANALYZE_DATA_FAQS} />
      <!-- #install target for the hero button; same chooser as the homepage -->
      <InstallChooser
        client:visible
        location="analyze_data_install"
        heading="Ask your spreadsheets questions"
        sub="Add Desktop Commander to ChatGPT or Claude, link your computer, and ask about your data in plain words."
      />
    </main>
    
    <Footer client:visible />
  </div>
</Layout>

<style is:global>
  @import '../../../../src/index.css';
</style>
