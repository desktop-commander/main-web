---
import Layout from '../layouts/Layout.astro';
import PostHogInit from '../../src/components/PostHogInit';
import Navigation from '../components/Navigation.astro';
import RemoteMcpPricing from '../../src/components/pricing/RemoteMcpPricing';
import PricingFAQ from '../../src/components/PricingFAQ';
import Footer from '../../src/components/Footer';
---

<Layout
  title="Pricing - Desktop Commander"
  description="Desktop Commander Remote MCP pricing. Free with 10,000 tool calls a month, Pro at $20/month for unlimited tool calls. The local MCP server stays free and open source."
>
  <!-- Load PostHog early to initialize analytics -->
  <PostHogInit client:load />

  <div class="min-h-screen bg-background">
    <Navigation />
    <main>
      <RemoteMcpPricing client:load />
      <PricingFAQ client:visible />
    </main>
    <Footer client:visible />
  </div>
</Layout>

<style is:global>
  @import '../../src/index.css';
</style>
