---
import Layout from '../layouts/Layout.astro';
import PostHogInit from '../../src/components/PostHogInit';
import Navigation from '../components/Navigation.astro';
import PricingSection from '../../src/components/PricingSection';
import PricingFAQ from '../../src/components/PricingFAQ';
import Footer from '../../src/components/Footer';
---

<Layout
  title="Pricing - Desktop Commander"
  description="Simple, transparent pricing. One Credits Plan from $20/month — access to the best AI models, change your bundle any time, cancel any time."
>
  <!-- Load PostHog early to initialize analytics -->
  <PostHogInit client:load />

  <div class="min-h-screen bg-background">
    <Navigation />
    <main>
      <PricingSection client:load />
      <PricingFAQ client:visible />
    </main>
    <Footer client:visible />
  </div>
</Layout>

<style is:global>
  @import '../../src/index.css';
</style>
